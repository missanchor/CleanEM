{
  "experiment": "contrastive_two_stage",
  "device_map": {
    "default": "cuda:0"
  },
  "num_workers": 0,
  "pin_memory": false,
  "persistent_workers": false,
  "seed": 123,
  "mock_data": {
    "type": "sales",
    "num_samples": 50,
    "name": "mock-sales-two-stage",
    "seed": 123
  },
  "stage_a": {
    "num_epochs": 1,
    "batch_size": 8,
    "temperature": 0.07,
    "tabular_encoder": {
      "type": "StructureAwareTransformer",
      "params": {
        "d_cell": 32,
        "d_model": 64,
        "nhead": 2,
        "num_layers": 1,
        "dim_feedforward": 128,
        "dropout": 0.1
      }
    },
    "text_encoder": {
      "type": "PretrainedTextEncoder",
      "params": {
        "vocab_size": 30522,
        "d_model": 64,
        "nhead": 2,
        "num_layers": 1,
        "max_seq_len": 128,
        "dropout": 0.1
      }
    },
    "optimizer": {
      "type": "Adam",
      "params": {"lr": 1e-4}
    }
  },
  "stage_b": {
    "num_epochs": 1,
    "batch_size": 16,
    "negative_ratio": 0.5,
    "negative_strategy": "random",
    "fusion_module": {
      "type": "CrossAttentionFusion",
      "params": {
        "d_model": 64,
        "nhead": 2,
        "dropout": 0.1
      }
    },
    "detection_head": {
      "type": "MLPDetectionHead",
      "params": {
        "d_input": 64,
        "hidden_dim": 64,
        "output_dim": 1
      }
    },
    "optimizer": {
      "type": "Adam",
      "params": {"lr": 1e-3}
    }
  },
  "tabular_processor": {
    "d_cell": 32
  },
  "text_processor": {
    "max_seq_len": 128
  }
}
